<html>
  <head>
    <title>Grocery Store</title>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="bg-slate-900 text-white min-h-screen flex items-center justify-center">
    <main class="max-w-md p-6 bg-slate-800 rounded-xl shadow-lg text-center">
      <h1 class="text-3xl font-bold underline">Grocery Store</h1>
      <% allStoreCategories.forEach((category => { %>
        <p><%= category.name %> <%= category.price %></p>
      <% })) %>
      <p class="mt-2 text-slate-300">
        Your EJS views are styled and working seamlessly!
      </p>
    </main>
  </body>
</html>
