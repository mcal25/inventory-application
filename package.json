{
  "name": "inventory-application",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node --import=specifier-resolution-node/register --watch app.js",
    "populate": "node --env-file=.env ./db/populatedb.js",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch",
    "watch:server": "nodemon --ext js,ejs app.js",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcal25/inventory-application.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mcal25/inventory-application/issues"
  },
  "homepage": "https://github.com/mcal25/inventory-application#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "specifier-resolution-node": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  }
}
